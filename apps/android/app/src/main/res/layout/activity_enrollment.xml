<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy the Pairing Bundle in the VAJRA web console and tap Paste Pairing Bundle below, or enter each field manually. Confirm the device in the web console after submitting."
            android:textSize="14sp" />
        <Button
            android:id="@+id/btnPasteBundle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/paste_pairing_bundle" />
        <EditText
            android:id="@+id/inputServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Server URL (e.g. https://vajra.example.com)"
            android:inputType="textUri" />
        <EditText
            android:id="@+id/inputToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Enrollment token"
            android:inputType="textVisiblePassword" />
        <EditText
            android:id="@+id/inputDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Device ID (UUID)"
            android:inputType="text" />
        <EditText
            android:id="@+id/inputChallenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Challenge nonce"
            android:inputType="textVisiblePassword" />
        <Button
            android:id="@+id/btnSubmitEnroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Submit enrollment" />
        <TextView
            android:id="@+id/txtEnrollResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
