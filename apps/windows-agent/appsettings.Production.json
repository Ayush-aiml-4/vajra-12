{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http": "Warning"
    }
  },
  "VajraAgent": {
    "ServerBaseUrl": "https://REPLACE_WITH_VAJRA_HOSTNAME",
    "DataDirectory": "",
    "HeartbeatIntervalSeconds": 60,
    "CommandPollIntervalSeconds": 30,
    "EventCollectIntervalSeconds": 120,
    "HttpTimeoutSeconds": 30,
    "MaxRetryBackoffSeconds": 180,
    "KeyAlgorithm": "ECDSA_P256",
    "AgentVersion": "0.1.0-windows"
  }
}
